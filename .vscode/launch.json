{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Build & Launch (Debug)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/Bot/bin/Debug/net10.0/Bot.exe",
            "args": ["36969"],
            "cwd": "${workspaceFolder}/Bot",
            "stopAtEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Attach to Bot (RLBot lancé)",
            "type": "coreclr",
            "request": "attach",
            "processName": "Bot"
        },
        {
            "name": "Run state_setting_tests.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/state_setting_tests.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run state_setting_fixes.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/state_setting_tests_fixes.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
    ]
}
