{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/RedUtils/Bot/Bot.csproj",
                "-c", "Debug"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build release",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/RedUtils/Bot/Bot.csproj",
                "-c", "Release"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
